#!/bin/bash

confdir="$HOME/.config/LovdogLiveWallpaper/"
widgets="${confdir}/widgets"
## cd to file parent
cd "$(dirname "${BASH_SOURCE[0]}")"

function align_merge(){
    if [ $# -eq 1 ]; then cat "$1"; fi
    file1=$1;
    file2=$2;
    w=$(wc -L < file1); paste file1 file2 | awk -v w=$w -F'\t' '{ printf "%-*s  %s\n", w, $1, $2 }'
}

for widgetfile in `cat ${widgets}`; do
    align_merge ${widgetfile}
done

