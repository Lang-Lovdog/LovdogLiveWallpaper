#!/bin/bash

# --- CONFIGURACIÓN DE GLIFOS (Nerd Fonts) ---
REPE=""
ALAR="󰀠"

# 1. CÁLCULO DE FECHAS
PRIMER_DIA_MES=$(date +%Y-%m-01)
# 2 semanas antes para dar contexto al calendario
START_DATE=$(date -d "$PRIMER_DIA_MES - 14 days" +%Y-%m-%d)

# Datos para el resaltado
D_HOY=$(date +%e | tr -d ' ')
S_HOY=$(date +%V | sed 's/^0//')

# 2. CAPTURA (Sin color original para procesar limpiamente)
mapfile -t CAL < <(khal --color calendar "$START_DATE")

# 3. ARITMÉTICA DE POSICIÓN
# Localizamos la semana de referencia en la salida de khal
FIRST_WEEK=$(echo "${CAL[1]}" | awk '{print $NF}') # Usamos NF para mayor robustez

if [ "$S_HOY" -lt "$FIRST_WEEK" ]; then
    OFFSET=$(( (52 - FIRST_WEEK) + S_HOY + 1 ))
else
    OFFSET=$(( S_HOY - FIRST_WEEK + 1 ))
fi

# 4. RESALTADO ANSI (Inyección de Atributo Invertir: \e[7m)
# Esto será capturado por tu función update_attributes y activará TermColor::INVERT
if [ -n "${CAL[$OFFSET]}" ]; then
    ESC_INV=$(printf '\033[7m')
    ESC_RST=$(printf '\033[0m')
    
    if [ ${#D_HOY} -eq 2 ]; then
        # Reemplazo para días de dos dígitos
        CAL[$OFFSET]=$(echo "${CAL[$OFFSET]}" | sed -E "s/ $D_HOY / ${ESC_INV}${D_HOY}${ESC_RST} /")
    else
        # Reemplazo para días de un dígito (manteniendo el espaciado de la terminal)
        CAL[$OFFSET]=$(echo "${CAL[$OFFSET]}" | sed -E "s/  $D_HOY /  ${ESC_INV}${D_HOY}${ESC_RST} /")
    fi
fi

# 5. SALIDA CON REEMPLAZO DE GLIFOS
# Sustituimos los placeholders por tus Nerd Fonts y enviamos al FIFO
printf "%s\n" "${CAL[@]}" | sed "s/⟳/$REPE/g; s/⏰/$ALAR/g"
