#!/bin/bash

tmp_dir='/tmp/lovdog_live_wallpaper'
pid_file="$tmp_dir/widgets.pid"
file_lock="$tmp_dir/widgets_continue"

# --- Lógica de Bloqueo de PID ---
if [ -f "$pid_file" ]; then
    old_pid=$(cat "$pid_file")
    # Verificar si el proceso realmente existe
    if ps -p "$old_pid" > /dev/null 2>&1; then
        echo "Ya hay una instancia de widgets corriendo (PID: $old_pid). Saliendo."
        exit 0
    fi
fi

# Registrar el PID actual
echo $$ > "$pid_file"

# Limpieza al salir (trampa para señales)
cleanup() {
    rm -f "$pid_file" "$file_lock"
    pkill -P $$ # Mata a todos los hijos (khal, wttr, etc.)
    exit 0
}

trap cleanup SIGINT SIGTERM EXIT
# --------------------------------

# Función para crear el FIFO si no existe
prepare_fifo() {
    [ ! -p "$1" ] && mkfifo "$1"
}

# Preparamos todos los pipes
for w in khal todo wttr1 wttrin sensors; do
    prepare_fifo "${widget_prefix}_$w"
done

while [ -f "$file_lock" ]; do
  # Usamos redirección con '>' pero de forma no bloqueante 
  # o asegurando que el C++ esté listo.
  
  (khal calendar --format "{start-time} {title}" now 7d > "${widget_prefix}_khal") &
  (todo > "${widget_prefix}_todo") &
  # Reporte de una línea (Salamanca)
  (
    # Guardamos todo en la variable 'out'
    out=$(./get_wttr)
    # Solo escribimos al FIFO si logramos obtener datos
    [[ -n "$out" ]] && echo "$out" > "${widget_prefix}_wttrin"
  ) &

  # Clima completo (wttr.in)
  (
    out=$(curl -s 'wttr.in/Salamanca?T&3')
    [[ -n "$out" ]] && echo "$out" > "${widget_prefix}_wttr1"
  ) &
  (./llw-sensors > "${widget_prefix}_sensors") &

  wait # Esperamos a que los subprocesos terminen de escribir en los pipes
  sleep 3s
done
