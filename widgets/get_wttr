#!/usr/bin/env bash
url='https://wttr.in/?format=j1'
ico_rain=""      # glifo nerdfont para lluvia
ico_temp=""      # glifo nerdfont para termómetro
labels=("Hoy" "Mañana" "Pasado")

# Obtener JSON
json=$(curl -s "$url") || { echo "Error en curl"; exit 1; }

# Función para procesar un día (índice 0,1,2)
print_day() {
    local idx=$1
    local label=$2

    # Extraer el array hourly del día correspondiente
    local hourly
    hourly=$(echo "$json" | jq -c ".weather[$idx].hourly[]")

    # Inicializar arrays para los 5 bloques horarios
    declare -A prob temp sens
    for slot in {1..5}; do
        prob[$slot]=0
        temp[$slot]="--"
        sens[$slot]="--"
    done

    # Procesar cada hora
    while IFS= read -r hour; do
        time=$(echo "$hour" | jq -r '.time | tonumber')
        chance=$(echo "$hour" | jq -r '.chanceofrain // "0"')
        t=$(echo "$hour" | jq -r '.tempC // "null"')
        f=$(echo "$hour" | jq -r '.FeelsLikeC // "null"')

        # Asignar a bloque según la hora
        if [ "$time" -ge 600 ] && [ "$time" -lt 1200 ]; then slot=1
        elif [ "$time" -ge 1200 ] && [ "$time" -lt 1600 ]; then slot=2
        elif [ "$time" -ge 1600 ] && [ "$time" -lt 2000 ]; then slot=3
        elif [ "$time" -ge 2000 ] && [ "$time" -lt 2400 ]; then slot=4
        else slot=5
        fi

        prob[$slot]=$chance
        temp[$slot]=$t
        sens[$slot]=$f
    done <<< "$hourly"

    # Mostrar la línea con el formato que tenías
    printf "%-7s | %s Prob lluvia [%2s%% | %2s%% | %2s%% | %2s%% | %2s%%] | %s Temp [%2s°C | %2s°C]\n" \
        "$label" "$ico_rain" "${prob[1]}" "${prob[2]}" "${prob[3]}" "${prob[4]}" "${prob[5]}" \
        "$ico_temp" "${temp[2]}" "${sens[2]}"
}

# Procesar los tres días
echo "" > /tmp/lovdog_live_wallpaper_widget_wttrin
for i in 0 1 2; do
    print_day "$i" "${labels[$i]}" >> /tmp/lovdog_live_wallpaper_widget_wttrin
done
